# ============================================================
# BypassX Management - Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.
# ============================================================

# Your Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Neon Postgres connection string (free tier)
# Get one at https://neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Default command prefix (slash commands are primary, this is legacy fallback)
DEFAULT_PREFIX=bx!

# Bot owner ID (your Discord user ID) - used for owner-only commands
# Right-click your name in Discord > Copy ID (Developer Mode required)
OWNER_ID=0

# Optional: status text the bot shows as "Playing ..."
BOT_STATUS=managing servers | /help

# Optional: webhook URL for critical error alerts (leave blank to disable)
ERROR_WEBHOOK_URL=

# Enable verbose console logging (true/false)
DEBUG=false
